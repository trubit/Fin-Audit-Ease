# FinAuditEase Frontend Environment Configuration
# NOTE: Only frontend-safe variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER store secrets, database passwords, private keys, or signing keys here.

# Central Backend API Origin (Required - Direct communication origin for backend API)
# Example local backend: VITE_API_BASE_URL=http://localhost:5000 (replace 5000 with your confirmed backend port)
# Example staging/prod:  VITE_API_BASE_URL=https://api.finauditease.ng
VITE_API_BASE_URL=

# Application Environment ('development' | 'production' | 'staging')
VITE_APP_ENV=development

# Session Inactivity Timeout in milliseconds (Default: 30 minutes = 1800000)
VITE_SESSION_TIMEOUT_MS=1800000

# Session Inactivity Warning Dialog in milliseconds (Default: 2 minutes = 120000)
VITE_SESSION_WARNING_MS=120000

# Enable Temporary Development Preview Login (Set to 'false' to disable in production)
VITE_ENABLE_DEV_AUTH=true
